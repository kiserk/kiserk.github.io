---
// Site-wide mycelium easter egg — meant to be stumbled into, never advertised.
//
// Rest the cursor and it morphs into a hyphal tip while a small colony blooms
// where it sits. Press and hold and the page dissolves into the full growth sim
// (src/scripts/mycelium-renderer.ts). ESC or the ✕ returns.
//
// Three invariants keep a decorative toy from breaking a working site:
//   1. The bloom is bounded (radius + tip cap) and continuously erased, so it
//      settles into a small living cluster instead of creeping over the page.
//   2. An uncommitted bloom recedes on its own after SEED_LIFE_MS, leaving no
//      trace — a visitor who parks the cursor and reads is never left with
//      artefacts on the background.
//   3. Nothing is click-catching except the deliberate full-screen mode. Idle
//      and blooming are `pointer-events: none`, so a link is always reachable.
// Decorative (aria-hidden while idle), so it has no effect on content or SEO.
---

<div id="myc-cursor" aria-hidden="true">
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round">
    <path d="M12 12 C10 10 8.5 7.5 7 5" />
    <path d="M7 5 l-1.6 0.2 M7 5 l0.4 -1.6" />
    <path d="M12 12 C14 10.5 16.5 9.5 19 8.5" />
    <path d="M19 8.5 l1.4 0.7 M19 8.5 l0.9 -1.3" />
    <path d="M12 12 C13 14.5 13.8 17 14 19.5" />
    <path d="M14 19.5 l1.5 0.4 M14 19.5 l-1.3 0.9" />
    <path d="M12 12 C9.5 13.5 7 15 5 17" />
    <path d="M5 17 l-1.5 -0.2 M5 17 l0.2 1.5" />
    <circle cx="12" cy="12" r="1.3" fill="currentColor" stroke="none" />
  </svg>
</div>

<div id="myc-overlay" aria-hidden="true" data-state="idle">
  <canvas id="myc-canvas"></canvas>
  <canvas id="myc-fx"></canvas>
  <button id="myc-exit" type="button" aria-label="Leave the mycelium">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <path d="M6 6 L18 18 M18 6 L6 18" />
    </svg>
  </button>
  <span id="myc-hint">click to feed · arrows to steer · <b>esc to return</b></span>
</div>

<style>
  #myc-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 70;
    width: 22px;
    height: 22px;
    margin: -11px 0 0 -11px;
    color: rgba(210, 222, 220, 0.92);
    pointer-events: none;
    opacity: 0;
    transform: scale(0.6) rotate(-8deg);
    transition: opacity 0.45s ease, transform 0.45s ease;
    filter: drop-shadow(0 0 4px rgba(120, 200, 180, 0.5));
    will-change: transform, opacity;
  }
  :global(body.myc-dwell) #myc-cursor {
    opacity: 0.85;
    transform: scale(1) rotate(0deg);
  }

  #myc-overlay {
    position: fixed;
    inset: 0;
    z-index: 60;
    opacity: 0;
    /* Idle and blooming are inert: a link is always reachable. Only the
       deliberate full-screen mode takes pointer events. */
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.6s ease, visibility 0s linear 0.6s;
  }
  #myc-overlay::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 120% at 50% 40%, rgba(6, 10, 16, 0.55) 0%, rgba(3, 5, 9, 0.72) 100%);
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  /* Bloom: the colony is visible over the live page, nothing is captured.
     Also the state used while a colony dissolves back out. */
  #myc-overlay[data-state='bloom'] {
    opacity: 1;
    visibility: visible;
    pointer-events: none;
    transition: opacity 0.6s ease, visibility 0s;
  }

  #myc-overlay[data-state='game'] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    cursor: none;
    transition: opacity 0.6s ease, visibility 0s;
  }
  #myc-overlay[data-state='game']::before {
    opacity: 1;
  }

  #myc-canvas,
  #myc-fx {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Freeze the page behind the sim so returning puts you back where you were. */
  :global(body.myc-active) {
    overflow: hidden;
  }

  /* Entering can happen by accident, so the way out is stated plainly and
     immediately — no fade-in delay, no whisper-grey. */
  #myc-hint {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(226, 236, 232, 0.72);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.7);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  #myc-hint b {
    font-weight: 400;
    color: rgba(150, 226, 198, 0.95);
  }
  #myc-overlay[data-state='game'] #myc-hint {
    opacity: 1;
  }

  #myc-exit {
    position: fixed;
    top: max(0.9rem, env(safe-area-inset-top));
    right: max(0.9rem, env(safe-area-inset-right));
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 999px;
    border: 1px solid rgba(220, 230, 226, 0.32);
    background: rgba(8, 12, 18, 0.42);
    color: rgba(226, 236, 232, 0.8);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease, color 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  }
  #myc-overlay[data-state='game'] #myc-exit {
    opacity: 0.85;
    pointer-events: auto;
  }
  #myc-exit:hover,
  #myc-exit:focus-visible {
    opacity: 1;
    color: rgba(240, 248, 244, 1);
    border-color: rgba(220, 230, 226, 0.6);
    background: rgba(8, 12, 18, 0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    #myc-cursor { display: none; }
    #myc-overlay,
    #myc-hint { transition: none; }
    #myc-exit { transition: opacity 0.2s ease; }
  }
</style>

<script>
  import { MyceliumRenderer } from '../scripts/mycelium-renderer';

  const DWELL_MS = 4000;        // cursor stillness before a colony seeds
  const SEED_LIFE_MS = 20000;   // an uncommitted bloom recedes after this
  const SEED_RADIUS = 195;      // px — keeps the bloom a cluster, not a takeover
  const SEED_TIPS = 44;
  const SEED_FADE = 0.0006;     // erase rate; balances growth into a steady bloom
  const SEED_INIT_SPEED = 0.3;
  const SEED_SLOW_SPEED = 0.09;
  const SEED_SLOW_AFTER = 2800;
  const SEED_ABANDON = 16;      // px of cursor travel that abandons a bloom

  // A deliberate hold. Long enough that ordinary clicking — including a slow
  // trackpad click — can never fall into the sim, short enough that curiosity
  // finds it. This being 260ms is what used to eat clicks on real links.
  const HOLD_MS = 850;
  const MOVE_TOL = 6;

  const GAME_SPEED = 0.26;
  const GAME_FADE = 0.0004;     // very slow decay, so long sessions can't white out
  const DISSOLVE_MS = 1500;

  type Mode = 'idle' | 'bloom' | 'game';

  function init() {
    const cursorEl = document.getElementById('myc-cursor');
    const overlay = document.getElementById('myc-overlay');
    const canvas = document.getElementById('myc-canvas') as HTMLCanvasElement | null;
    const fxCanvas = document.getElementById('myc-fx') as HTMLCanvasElement | null;
    const exitBtn = document.getElementById('myc-exit');
    if (!cursorEl || !overlay || !canvas || !fxCanvas) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    let renderer: MyceliumRenderer | null = null;
    let mode: Mode = 'idle';
    let lastFocused: HTMLElement | null = null;

    let dwellTimer: number | undefined;
    let holdTimer: number | undefined;
    let seedSlowTimer: number | undefined;
    let seedLifeTimer: number | undefined;
    let dissolveTimer: number | undefined;

    let downPoint: { x: number; y: number } | null = null;
    let seedOrigin: { x: number; y: number } | null = null;
    const pointer = { x: window.innerWidth / 2, y: window.innerHeight / 2 };

    const isInteractive = (t: EventTarget | null) =>
      t instanceof Element &&
      !!t.closest('a, button, input, textarea, select, label, summary, [role="button"], [contenteditable]');

    const hasSelection = () => (window.getSelection()?.toString().length ?? 0) > 0;

    function clearGrowthTimers() {
      window.clearTimeout(seedSlowTimer);
      window.clearTimeout(seedLifeTimer);
    }

    /**
     * Tear down the colony and blank the canvas. Deliberately says nothing
     * about the overlay's visibility — callers own that, so starting a new
     * colony can't have its own state clobbered by the teardown of the old one.
     */
    function disposeRenderer() {
      window.clearTimeout(dissolveTimer);
      dissolveTimer = undefined;
      renderer?.destroy();
      renderer = null;
    }

    /** Let the colony erase itself, then tear down. Leaves no trace behind. */
    function softStop() {
      clearGrowthTimers();
      const finish = () => {
        disposeRenderer();
        // Only hide if nothing new started while this one was dissolving.
        if (mode === 'idle') overlay!.dataset.state = 'idle';
      };
      if (!renderer) {
        finish();
        return;
      }
      renderer.dissolve();
      window.clearTimeout(dissolveTimer);
      dissolveTimer = window.setTimeout(finish, DISSOLVE_MS);
    }

    // --- bloom ------------------------------------------------------------
    function startBloom() {
      if (mode !== 'idle') return;
      disposeRenderer(); // a dissolving colony must not share the canvas with a new one

      mode = 'bloom';
      seedOrigin = { x: pointer.x, y: pointer.y };
      overlay!.dataset.state = 'bloom';

      cursorEl!.style.left = `${pointer.x}px`;
      cursorEl!.style.top = `${pointer.y}px`;
      document.body.classList.add('myc-dwell');

      renderer = new MyceliumRenderer(canvas!, fxCanvas!, { x: pointer.x, y: pointer.y });
      renderer.setMaxRadius(SEED_RADIUS);
      renderer.setMaxTips(SEED_TIPS);
      renderer.setFade(SEED_FADE);
      renderer.setSpeed(SEED_INIT_SPEED);
      renderer.start();

      seedSlowTimer = window.setTimeout(() => {
        if (mode === 'bloom') renderer?.setSpeed(SEED_SLOW_SPEED);
      }, SEED_SLOW_AFTER);

      // The invariant that matters: an ignored bloom always goes away.
      seedLifeTimer = window.setTimeout(() => {
        if (mode === 'bloom') endBloom();
      }, SEED_LIFE_MS);
    }

    function endBloom() {
      if (mode !== 'bloom') return;
      mode = 'idle';
      seedOrigin = null;
      document.body.classList.remove('myc-dwell');
      softStop();
    }

    function armDwell(target: EventTarget | null) {
      window.clearTimeout(dwellTimer);
      if (mode !== 'idle') return;
      if (isInteractive(target) || hasSelection()) return;
      dwellTimer = window.setTimeout(startBloom, DWELL_MS);
    }

    function cancelHold() {
      window.clearTimeout(holdTimer);
      downPoint = null;
    }

    // --- full sim ---------------------------------------------------------
    function enterGame(x: number, y: number) {
      if (mode === 'game') return;
      window.clearTimeout(dwellTimer);
      clearGrowthTimers();
      cancelHold();
      window.getSelection()?.removeAllRanges();
      document.body.classList.remove('myc-dwell');

      const carriedOver = mode === 'bloom' && renderer;
      mode = 'game';
      overlay!.dataset.state = 'game';
      overlay!.removeAttribute('aria-hidden');
      document.body.classList.add('myc-active');
      lastFocused = document.activeElement as HTMLElement | null;

      if (!carriedOver) {
        disposeRenderer();
        renderer = new MyceliumRenderer(canvas!, fxCanvas!, { x, y });
        renderer.start();
      }
      // The bloom you grew becomes the colony you play with — it just stops
      // being confined and starts foraging toward the cursor.
      renderer!.setMaxRadius(Infinity);
      renderer!.setMaxTips(70);
      renderer!.setFade(GAME_FADE);
      renderer!.setSpeed(GAME_SPEED);
      renderer!.setBias(x, y);

      exitBtn?.focus();
    }

    function exitGame() {
      if (mode !== 'game') return;
      mode = 'idle';
      seedOrigin = null;
      // Veil lifts at once; the colony erases itself on the way out.
      overlay!.dataset.state = 'bloom';
      overlay!.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('myc-active');
      softStop();

      lastFocused?.focus?.();
      lastFocused = null;
    }

    // --- pointer ----------------------------------------------------------
    window.addEventListener(
      'pointermove',
      (e) => {
        pointer.x = e.clientX;
        pointer.y = e.clientY;

        if (mode === 'game') {
          renderer?.setBias(e.clientX, e.clientY);
          return;
        }

        if (downPoint && Math.hypot(e.clientX - downPoint.x, e.clientY - downPoint.y) > MOVE_TOL) {
          cancelHold();
        }

        if (mode === 'bloom') {
          if (seedOrigin && Math.hypot(e.clientX - seedOrigin.x, e.clientY - seedOrigin.y) > SEED_ABANDON) {
            endBloom();
            armDwell(e.target);
          }
          return;
        }

        if (document.body.classList.contains('myc-dwell')) {
          cursorEl!.style.left = `${pointer.x}px`;
          cursorEl!.style.top = `${pointer.y}px`;
        }
        armDwell(e.target);
      },
      { passive: true }
    );

    window.addEventListener('pointerdown', (e) => {
      if (mode === 'game') {
        if (e.button === 0 && e.target !== exitBtn) renderer?.dropNutrient(e.clientX, e.clientY);
        return;
      }
      if (e.button !== 0) return;
      if (isInteractive(e.target) || hasSelection()) return;
      downPoint = { x: e.clientX, y: e.clientY };
      holdTimer = window.setTimeout(() => {
        if (downPoint) enterGame(downPoint.x, downPoint.y);
      }, HOLD_MS);
    });

    window.addEventListener('pointerup', cancelHold);
    window.addEventListener('pointercancel', cancelHold);
    window.addEventListener('blur', () => {
      cancelHold();
      window.clearTimeout(dwellTimer);
      if (mode === 'bloom') endBloom();
    });

    // --- keyboard ---------------------------------------------------------
    window.addEventListener('keydown', (e) => {
      if (mode === 'idle') return;
      if (e.key === 'Escape') {
        if (mode === 'game') exitGame();
        else endBloom();
        return;
      }
      if (mode !== 'game') return;
      const nudges: Record<string, [number, number]> = {
        ArrowUp: [0, -1],
        ArrowDown: [0, 1],
        ArrowLeft: [-1, 0],
        ArrowRight: [1, 0],
      };
      const n = nudges[e.key];
      if (n) {
        e.preventDefault();
        renderer?.nudge(n[0], n[1]);
      }
    });

    // Typing anywhere cancels a pending bloom — you're working, not idling.
    window.addEventListener('keydown', () => {
      if (mode === 'idle') window.clearTimeout(dwellTimer);
    });

    exitBtn?.addEventListener('pointerdown', (e) => e.stopPropagation());
    exitBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      exitGame();
    });

    window.addEventListener('resize', () => {
      if (mode !== 'idle') renderer?.resize();
    });

    // Nothing should grow in a tab nobody is looking at.
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) return;
      window.clearTimeout(dwellTimer);
      cancelHold();
      if (mode === 'bloom') endBloom();
    });

    window.addEventListener('pagehide', () => {
      if (mode === 'game') exitGame();
      else if (mode === 'bloom') endBloom();
      disposeRenderer();
    });

    // Handle used by the offline tuning page (src/pages/mycelium-preview.astro).
    (window as any).__myc = {
      start: (x?: number, y?: number) =>
        enterGame(x ?? window.innerWidth / 2, y ?? window.innerHeight / 2),
      stop: exitGame,
      isActive: () => mode === 'game',
      getMode: () => mode,
      getRenderer: () => renderer,
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
