---
/**
 * "Ask about my experience" — a floating chat widget backed by the Cloudflare
 * Worker in /worker. Follows the same island pattern as the contact form
 * (src/pages/contact.astro): inline script, fetch, disabled-button pending
 * state, honeypot field, aria-live status.
 *
 * Renders nothing unless an endpoint is configured, so the default build is
 * unchanged and `chatEndpoint: ''` is a working kill switch.
 */
import { CHAT_ENABLED, CHAT_ENDPOINT } from '../config/chat';

const suggestions = [
  'What cultivation experience does he have?',
  'Has he done tech transfer?',
  'What has he published?',
];
---

{CHAT_ENABLED && (
  <div id="ask-root" data-endpoint={CHAT_ENDPOINT}>
    <button
      type="button"
      id="ask-toggle"
      class="ask-fab"
      aria-expanded="false"
      aria-controls="ask-panel"
      aria-label="Ask about my experience"
      data-goatcounter-click="ask-open"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
      </svg>
      <span class="ask-fab-label">Ask about my experience</span>
    </button>

    <div id="ask-panel" class="ask-panel surface" hidden role="dialog" aria-labelledby="ask-title">
      <header class="ask-head">
        <h2 id="ask-title">Ask about my experience</h2>
        <span class="ask-beta">beta</span>
        <button type="button" id="ask-reset" class="ask-headbtn">New</button>
        <button type="button" id="ask-close" class="ask-headbtn" aria-label="Close chat">✕</button>
      </header>

      <div id="ask-log" class="ask-log" role="log" aria-live="polite" aria-label="Conversation"></div>

      <div id="ask-chips" class="ask-chips">
        {suggestions.map((s) => (
          <button type="button" class="ask-chip" data-q={s}>{s}</button>
        ))}
      </div>

      <form id="ask-form" class="ask-form" novalidate>
        <input type="text" id="ask-botcheck" class="ask-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label class="sr-only" for="ask-input">Your question</label>
        <textarea
          id="ask-input"
          class="ask-input"
          rows="2"
          maxlength="1500"
          placeholder="Ask about Karl's work…"
        ></textarea>
        <button type="submit" id="ask-send" class="ask-send">
          <span id="ask-send-label">Send</span>
        </button>
      </form>

      <p class="ask-foot">
        Answers are AI-generated and may be wrong. ·
        <a href="/privacy">Privacy</a>
      </p>
    </div>
  </div>
)}

<style>
  #ask-root {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 60;
    font-family: var(--font-body);
  }

  .ask-fab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--surface-border);
    background: var(--surface);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: var(--surface-shadow);
    color: var(--ink);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.25s ease, transform 0.25s ease;
    opacity: 0.92;
  }
  .ask-fab:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  .ask-panel {
    display: flex;
    flex-direction: column;
    width: min(23rem, calc(100vw - 2rem));
    height: min(30rem, calc(100vh - 5rem));
    border-radius: 1rem;
    overflow: hidden;
    color: var(--ink);
  }
  .ask-panel[hidden] {
    display: none;
  }

  .ask-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 0.9rem;
    border-bottom: 1px solid var(--surface-border);
  }
  .ask-head h2 {
    flex: 1;
    margin: 0;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .ask-beta {
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
    border: 1px solid var(--surface-border);
    color: var(--ink-faint);
  }
  .ask-headbtn {
    background: none;
    border: none;
    padding: 0.15rem 0.3rem;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    cursor: pointer;
    transition: color 0.25s ease;
  }
  .ask-headbtn:hover {
    color: var(--ink);
  }

  .ask-log {
    flex: 1;
    overflow-y: auto;
    padding: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  /* Message bubbles are created in JS, so they never receive Astro's scoping
     attribute and a plain `.ask-msg` rule would silently not match. Scoping the
     ancestor and going :global on the descendant keeps these rules contained to
     the widget while still reaching dynamically inserted nodes. */
  .ask-log :global(.ask-msg) {
    max-width: 92%;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .ask-log :global(.ask-msg-user) {
    align-self: flex-end;
    background: rgba(255, 255, 255, 0.09);
    border: 1px solid var(--surface-border);
    border-radius: 0.75rem 0.75rem 0.15rem 0.75rem;
    padding: 0.45rem 0.7rem;
    color: var(--ink);
  }
  .ask-log :global(.ask-msg-bot) {
    align-self: flex-start;
    color: var(--ink-muted);
  }
  .ask-log :global(.ask-msg-err) {
    color: rgba(244, 150, 140, 0.95);
  }
  .ask-log :global(.ask-empty) {
    margin: 0;
    color: var(--ink-faint);
    font-size: 0.85rem;
  }

  .ask-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0 0.9rem 0.7rem;
  }
  .ask-chips[hidden] {
    display: none;
  }
  .ask-chip {
    padding: 0.3rem 0.6rem;
    font-size: 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--surface-border);
    background: var(--surface-inset);
    color: var(--ink-muted);
    cursor: pointer;
    text-align: left;
    transition: border-color 0.25s ease;
  }
  .ask-chip:hover {
    border-color: rgba(246, 244, 240, 0.5);
  }

  .ask-form {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    padding: 0 0.9rem 0.5rem;
  }
  /* Mirrors .contact-input from src/pages/contact.astro. Not reused directly:
     that class lives in a scoped <style> on the contact page, so it resolves to
     nothing everywhere else. */
  .ask-input {
    width: 100%;
    resize: none;
    background: var(--surface-inset);
    border: 1px solid var(--surface-border);
    border-radius: 0.625rem;
    padding: 0.5rem 0.65rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--ink);
    transition: border-color 0.25s ease, background 0.25s ease;
  }
  .ask-input::placeholder {
    color: var(--ink-faint);
    opacity: 0.7;
  }
  .ask-input:focus {
    outline: none;
    border-color: rgba(246, 244, 240, 0.7);
    background: rgba(255, 255, 255, 0.08);
  }
  .ask-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .ask-send {
    flex-shrink: 0;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    border: 1px solid currentColor;
    background: none;
    color: var(--ink);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.25s ease;
    opacity: 0.9;
  }
  .ask-send:hover:not(:disabled) {
    opacity: 1;
  }
  .ask-send:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .ask-foot {
    margin: 0;
    padding: 0 0.9rem 0.8rem;
    font-size: 0.68rem;
    line-height: 1.4;
    color: var(--ink-faint);
  }
  .ask-foot a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 30rem) {
    /* Collapses to an icon; the button keeps its name via aria-label, and the
       min sizes hold it at a 44px touch target. */
    .ask-fab-label {
      display: none;
    }
    .ask-fab {
      padding: 0.7rem;
      min-width: 44px;
      min-height: 44px;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ask-fab,
    .ask-send,
    .ask-chip,
    .ask-headbtn,
    .ask-input {
      transition: none;
    }
    .ask-fab:hover {
      transform: none;
    }
  }
</style>

<script>
  type Role = 'user' | 'assistant';
  interface Msg {
    role: Role;
    content: string;
  }
  interface Stored {
    cid: string;
    messages: Msg[];
    t: number;
  }

  const STORE_KEY = 'kk.ask.v1';
  const MAX_STORED = 24;
  const MAX_USER_TURNS = 12;
  // Reopen the panel on a new page only if the visitor was just using it.
  // Longer than this and popping open unprompted is an ambush, not a courtesy.
  const REOPEN_WINDOW_MS = 5 * 60 * 1000;

  const root = document.getElementById('ask-root');
  const toggle = document.getElementById('ask-toggle');
  const panel = document.getElementById('ask-panel');
  const log = document.getElementById('ask-log');
  const chips = document.getElementById('ask-chips');
  const form = document.getElementById('ask-form') as HTMLFormElement | null;
  const input = document.getElementById('ask-input') as HTMLTextAreaElement | null;
  const botcheck = document.getElementById('ask-botcheck') as HTMLInputElement | null;
  const send = document.getElementById('ask-send') as HTMLButtonElement | null;
  const sendLabel = document.getElementById('ask-send-label');
  const closeBtn = document.getElementById('ask-close');
  const resetBtn = document.getElementById('ask-reset');

  if (root && toggle && panel && log && chips && form && input && botcheck && send && sendLabel) {
    const endpoint = root.dataset.endpoint ?? '';

    let cid = crypto.randomUUID();
    let messages: Msg[] = [];
    let pending = false;
    let counted = false;

    // ---- persistence ----------------------------------------------------
    // The site is a static MPA: every nav click is a full page load that wipes
    // this island's state. Without sessionStorage a visitor who asks a question
    // and then clicks "CV" loses the thread — which is exactly the journey the
    // widget exists to serve.

    const save = () => {
      try {
        const payload: Stored = { cid, messages: messages.slice(-MAX_STORED), t: Date.now() };
        sessionStorage.setItem(STORE_KEY, JSON.stringify(payload));
      } catch {
        /* private mode / quota — the widget still works, it just won't persist */
      }
    };

    const load = (): number => {
      try {
        const rawValue = sessionStorage.getItem(STORE_KEY);
        if (!rawValue) return 0;
        const parsed = JSON.parse(rawValue) as Partial<Stored>;
        if (typeof parsed.cid !== 'string' || !Array.isArray(parsed.messages)) return 0;
        cid = parsed.cid;
        messages = parsed.messages.filter(
          (m): m is Msg =>
            !!m &&
            (m.role === 'user' || m.role === 'assistant') &&
            typeof m.content === 'string'
        );
        counted = messages.length > 0;
        return typeof parsed.t === 'number' ? parsed.t : 0;
      } catch {
        return 0;
      }
    };

    // ---- rendering ------------------------------------------------------

    const render = () => {
      log.textContent = '';

      if (messages.length === 0) {
        const hint = document.createElement('p');
        hint.className = 'ask-empty';
        hint.textContent =
          'Ask about roles, projects, publications, or the patent. Answers come only from what’s on this site.';
        log.appendChild(hint);
      }

      for (const m of messages) {
        const el = document.createElement('div');
        el.className = `ask-msg ask-msg-${m.role === 'user' ? 'user' : 'bot'}`;
        el.textContent = m.content;
        log.appendChild(el);
      }

      chips.hidden = messages.length > 0;
      log.scrollTop = log.scrollHeight;
    };

    const showTransient = (text: string, isError: boolean) => {
      const el = document.createElement('div');
      el.className = `ask-msg ask-msg-bot${isError ? ' ask-msg-err' : ''}`;
      el.textContent = text;
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
    };

    const setPending = (value: boolean) => {
      pending = value;
      send.disabled = value;
      sendLabel.textContent = value ? 'Thinking…' : 'Send';
    };

    // ---- open / close ---------------------------------------------------

    const open = () => {
      panel.hidden = false;
      toggle.hidden = true;
      toggle.setAttribute('aria-expanded', 'true');
      render();
      input.focus();
    };

    const close = () => {
      panel.hidden = true;
      toggle.hidden = false;
      toggle.setAttribute('aria-expanded', 'false');
      // The button was display:none a moment ago. Read a layout property to
      // force the style flush before focusing — without it the focus call is
      // silently dropped and keyboard users are stranded on <body>. Doing this
      // synchronously rather than in rAF matters: rAF does not run in a
      // backgrounded tab, so focus would never be restored there.
      void toggle.offsetWidth;
      toggle.focus();
    };

    toggle.addEventListener('click', open);
    closeBtn?.addEventListener('click', close);

    resetBtn?.addEventListener('click', () => {
      cid = crypto.randomUUID();
      messages = [];
      counted = false;
      try {
        sessionStorage.removeItem(STORE_KEY);
      } catch {
        /* ignore */
      }
      render();
      input.focus();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) close();
    });

    for (const chip of chips.querySelectorAll<HTMLButtonElement>('.ask-chip')) {
      chip.addEventListener('click', () => {
        input.value = chip.dataset.q ?? '';
        input.focus();
      });
    }

    // ---- sending --------------------------------------------------------

    const ask = async (text: string) => {
      if (pending) return;

      const userTurns = messages.filter((m) => m.role === 'user').length;
      if (userTurns >= MAX_USER_TURNS) {
        showTransient(
          'That’s a long conversation — hit “New” to start fresh, or email karl.j.kiser@gmail.com.',
          true
        );
        return;
      }

      messages.push({ role: 'user', content: text });
      render();
      save();
      setPending(true);

      if (!counted) {
        counted = true;
        const gc = (window as unknown as { goatcounter?: { count?: (o: unknown) => void } })
          .goatcounter;
        gc?.count?.({ path: 'ask-first-message', title: 'Ask widget used', event: true });
      }

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ cid, messages, botcheck: botcheck.value }),
        });
        const data = (await res.json().catch(() => ({}))) as {
          cid?: string;
          reply?: string;
          error?: string;
        };

        if (typeof data.cid === 'string') cid = data.cid;

        if (data.reply) {
          // Rate limits and upstream failures come back with a friendly reply
          // string too, so there is one render path for every outcome. Only
          // successful answers are kept in history — an error message replayed
          // as context on the next turn would confuse the model.
          if (res.ok && !data.error) {
            messages.push({ role: 'assistant', content: data.reply });
            render();
            save();
          } else {
            showTransient(data.reply, true);
          }
        } else {
          showTransient('Something went wrong answering that. Please try again.', true);
        }
      } catch {
        showTransient('Network error — please try again, or use the contact page.', true);
      } finally {
        setPending(false);
        input.focus();
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text) return;
      input.value = '';
      void ask(text);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form.requestSubmit();
      }
    });

    // ---- init -----------------------------------------------------------

    const lastActivity = load();
    if (messages.length > 0 && Date.now() - lastActivity < REOPEN_WINDOW_MS) {
      open();
    }
  }
</script>
