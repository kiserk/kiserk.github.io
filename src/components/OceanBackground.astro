---
// Site-wide background: one looping water clip over a matching still frame.
//
// Deliberately dumb. There is no canvas, no live swell data, and no timers —
// the still frame is a CSS background behind the <video>, so every failure mode
// (autoplay blocked, codec unsupported, reduced motion, decoder hiccup, Save-Data)
// degrades to the same image with nothing to flash through.
const CLIP = '/water/IMG_5047_twilight_mono';
---

<div class="water-bg" aria-hidden="true">
  <video
    id="water-video"
    class="water-bg__video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={`${CLIP}.jpg`}
    tabindex="-1"
  >
    {/* H.264 only, on purpose. It decodes on everything, and the VP9 webm that
        used to sit here was larger than the mp4 and listed second, so nothing
        ever fetched it. A browser that cannot play this gets the poster, which
        is a still of this same clip. */}
    <source src={`${CLIP}.mp4`} type="video/mp4" />
  </video>
</div>

<div class="water-scrim" aria-hidden="true"></div>

<style>
  .water-bg {
    position: fixed;
    inset: 0;
    z-index: -10;
    /* The still frame sits behind the video, and an opaque colour sits behind
       that, so there is never bare page to flash white through. */
    background-color: #0a0d12;
    background-image: url('/water/IMG_5047_twilight_mono.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .water-bg__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Reduced motion (and Save-Data, via the script below): keep the still frame. */
  @media (prefers-reduced-motion: reduce) {
    .water-bg__video {
      display: none;
    }
  }

  .water-scrim {
    position: fixed;
    inset: 0;
    z-index: -5;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.24) 48%,
      rgba(0, 0, 0, 0.24) 85%,
      rgba(0, 0, 0, 0.55) 100%
    );
  }
</style>

<script>
  // Visitors on a metered/limited connection get the still frame instead of a
  // multi-megabyte clip. Dropping the element also stops it buffering.
  const conn = (navigator as unknown as { connection?: { saveData?: boolean } }).connection;
  const video = document.getElementById('water-video') as HTMLVideoElement | null;
  if (conn?.saveData) {
    video?.remove();
  } else if (video) {
    // Older machines and browsers that cannot fetch or decode the clip fall back
    // to the still frame: the poster and the .water-bg background image are the
    // same frame, so dropping the element changes nothing visible.
    const toStill = () => video.remove();
    video.addEventListener('error', toStill);
    video.addEventListener('stalled', toStill);
    // A <source> that fails errors on the <source>, not the <video>.
    video.querySelector('source')?.addEventListener('error', toStill);
  }
</script>
