---
import { formatAuthors, type ConferenceAbstract } from '../data/publications';

interface Props {
  pub: ConferenceAbstract;
}

const { pub } = Astro.props;
---

<article class="rounded-xl p-6">
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-[family-name:var(--font-body)] text-[0.95rem] md:text-base leading-snug font-medium">
      {pub.title}
    </h3>
    {pub.firstAuthor && (
      <span class="shrink-0 text-[0.65rem] tracking-[0.15em] uppercase border border-white/25 rounded px-2 py-0.5 mt-0.5" style="color: var(--ink-muted);">
        1st Author
      </span>
    )}
  </div>
  <p class="text-[0.875rem] mt-3 leading-relaxed" style="color: var(--ink-muted);" set:html={formatAuthors(pub.authors)} />
  <div class="text-[0.85rem] mt-3" style="color: var(--ink-faint);">
    <span>{pub.year}</span>
  </div>
</article>
